{
  "name": "engine2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Engine2 — diorama engine for Ember Ashes: real 3D terrain, hex tactics, Ember's maps and rules.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8080 --strictPort --open /",
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort --open /",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.510.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "0.166.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.166.0",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.33.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
